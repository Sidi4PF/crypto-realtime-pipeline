# Producer (runs on the host)
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
BINANCE_WS_BASE=wss://stream.binance.com:9443
SYMBOLS=btcusdt,ethusdt,solusdt
RAW_TRADES_TOPIC=trades.raw
RAW_TRADES_PARTITIONS=3
LOG_EVERY_N=500

# Aggregation
AGG_OHLC_TOPIC=ohlc.1m
WINDOW_DURATION=1 minute
WATERMARK=10 seconds

# Object storage
# Leave S3_ENDPOINT empty to target real AWS S3.
# Set it to http://minio:9000 to run fully locally against MinIO.
S3_ENDPOINT=
S3_BUCKET=crypto-lake
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-3